              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Activity UUID or transaction hash."
              }
            ]
          },
          "docs": "Fetch a single Ethereum activity by UUID or transaction hash. See the index endpoint for activity type documentation."
        },
