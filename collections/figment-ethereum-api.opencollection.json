      "items": [
        {
          "info": {
            "name": "Get Validators",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.figment.io/ethereum/validators",
            "params": [
              {
                "name": "network",
                "value": "hoodi",
                "type": "query"
              },
              {
                "name": "withdrawal_address",
                "value": "0xE40F80618324C814cD444434670a44ba4583aE38",
                "type": "query",
                "description": "The validator's withdrawal address. Must be prefixed with `0x`."
              },
              {
                "name": "groups",
                "value": "be982d21-ff93-4092-b56a-f40bac865400,a0ba2333-c541-41f0-ad89-e29a268a3ee5",
                "type": "query",
                "description": "Filter using comma-separated group uuids."
              },
              {
                "name": "region",
                "value": "ca-central-1",
                "type": "query",
                "description": "The validator's geographic region. Only for Figment validators."
              },
              {
                "name": "status",
                "value": "active_ongoing",
                "type": "query",
                "description": "The current validator's status. See https://docs.figment.io/docs/lifecycle-eth-validator."
              },
              {
                "name": "net_fee_payout_address",
                "value": "0xE40F80618324C814cD444434670a44ba4583aE38",
                "type": "query",
                "description": "The ETH wallet address that receives the net execution layer rewards (when they go through a fee splitting smart contract)."
              },
              {
                "name": "staking_request_id",
                "value": "f8bd4623-39ed-46ec-8518-991792665e56",
                "type": "query",
                "description": "The ID associated to the request for a set of valdiators."
              },
              {
                "name": "credentials_prefix",
                "value": "0x02",
                "type": "query",
                "description": "Filter for withdrawal_credentials field"
              },
              {
                "name": "include_fields",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get Validators"
        },
