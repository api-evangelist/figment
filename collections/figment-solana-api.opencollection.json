                "name": "network",
                "value": "mainnet",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Activity UUID or transaction hash."
              }
            ]
          },
          "docs": "Fetch a single Solana activity by UUID or transaction hash. See the index endpoint for activity type documentation."
        },
